<?xml version="1.0" encoding="utf-8"?>
<!-- POR QUE ISSO FOI FEITO:
     Os Slides 2, 9 e 10 exigem que o histórico textual e a conclusão da partida
     fiquem na mesma tela e se acomodem em ecrãs pequenos através de rolagem. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_obsidian_primary"
    android:fillViewport="true"
    tools:context=".SecretCodeActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <!-- Título e Regras das Pistas inspiradas no TERMO (Slide 9) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/t5_title"
            android:textColor="@color/accent_sunset_amber"
            android:textSize="@dimen/text_title_hero"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/t5_rules"
            android:textColor="@color/text_cool_silver"
            android:textSize="@dimen/text_body_regular" />

        <!-- Contador de Tentativas (Máximo de 8 tentativas - Slide 9) -->
        <TextView
            android:id="@+id/tvContadorTentativas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/accent_champagne_gold"
            android:textSize="@dimen/text_body_regular"
            android:textStyle="bold"
            tools:text="Tentativas utilizadas: 0 / 8" />

        <!-- Campo numérico com inputType="number" e limite de 4 dígitos (Slides 9 e 13) -->
        <EditText
            android:id="@+id/etPalpiteCodigo"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input_atelier"
            android:gravity="center"
            android:hint="@string/t5_hint_guess"
            android:importantForAutofill="no"
            android:inputType="number"
            android:letterSpacing="0.25"
            android:maxLength="4"
            android:paddingHorizontal="16dp"
            android:textColor="@color/text_warm_ivory"
            android:textColorHint="@color/text_slate_hint"
            android:textSize="@dimen/text_title_section"
            android:textStyle="bold" />

        <!-- Botão Tentar (Slide 9) -->
        <Button
            android:id="@+id/btnTentarCodigo"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/accent_sunset_amber"
            android:text="@string/t5_btn_try"
            android:textColor="@color/text_dark_on_gold"
            android:textStyle="bold" />

        <!-- PAINEL DE CONCLUSÃO NA MESMA TELA (Slide 10):
             Exibe vitória ou derrota, quantidade de tentativas e tempo decorrido com animação. -->
        <TextView
            android:id="@+id/tvConclusaoCofre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_atelier"
            android:gravity="center"
            android:padding="@dimen/card_padding"
            android:textColor="@color/text_warm_ivory"
            android:textSize="@dimen/text_body_regular"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="🔓 VITÓRIA! Você descobriu o código 4271 em 3 tentativa(s)!\nTempo decorrido: 18 s."
            tools:visibility="visible" />

        <!-- Histórico Textual das Tentativas abaixo do campo (Slide 9) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/t5_history_title"
            android:textColor="@color/text_warm_ivory"
            android:textSize="@dimen/text_body_regular"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHistoricoTentativas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_atelier"
            android:lineSpacingExtra="8dp"
            android:padding="@dimen/card_padding"
            android:text="@string/t5_history_empty"
            android:textColor="@color/text_cool_silver"
            android:textSize="@dimen/text_body_regular" />

        <!-- Botão Nova Partida (Slide 10) -->
        <Button
            android:id="@+id/btnNovaPartidaCofre"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="18dp"
            android:backgroundTint="@color/accent_champagne_gold"
            android:text="@string/t5_btn_new_game"
            android:textColor="@color/text_dark_on_gold"
            android:textStyle="bold" />

        <!-- Botões de Navegação e Pilha de Activities (Slide 12) -->
        <Button
            android:id="@+id/btnVoltarCentralCofre"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/bg_graphite_input"
            android:text="@string/btn_back_central"
            android:textColor="@color/text_warm_ivory" />

        <Button
            android:id="@+id/btnEncerrarSessaoCofre"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/danger_crimson"
            android:text="@string/btn_end_session"
            android:textColor="@color/text_warm_ivory"
            android:textStyle="bold" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>